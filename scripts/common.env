# Shared settings so llm-d and Ray Serve run the *same* vLLM engine config.
# FP8 weights (Marlin weight-only on Ampere) halve weight memory to ~0.75 GiB, which is
# what lets two replicas share a 4 GiB GPU. Same checkpoint for both stacks.
MODEL=Qwen/Qwen3-0.6B-FP8
BASE_PORT=8000

# Address every component uses to reach the others. Not 127.0.0.1: under WSL2
# mirrored networking, loopback TCP connections are refused on this machine.
# The llm-d file-discovery plugin also requires a literal IPv4 here.
HOST_IP=${HOST_IP:-$(hostname -I | awk '{print $1}')}

# Sized for two replicas on a 4 GiB RTX 2050: ~3k tokens of KV cache each.
# The small KV cache is deliberate: cache-aware routing only matters under cache pressure.
VLLM_ARGS=(
  # Explicit KV size instead of --gpu-memory-utilization: with several vLLM processes
  # on one GPU, the utilization budget counts the other replicas' memory and the
  # second replica ends up with a negative KV budget.
  --kv-cache-memory-bytes 350000000
  # Still checked at startup (free memory >= util * total), so keep it below what
  # remains free once the other replicas are up.
  --gpu-memory-utilization 0.3
  --max-model-len 2048
  --max-num-seqs 32
  --enforce-eager
  --enable-prefix-caching
  # Report usage.prompt_tokens_details.cached_tokens per response: the benchmark's
  # router-agnostic measure of prefix-cache hits.
  --enable-prompt-tokens-details
)

# WSL2 supports pinned memory (kernel >= 4.19.121) but vLLM keeps it off unless asked;
# vLLM's v2 model runner refuses to start without it ("UVA is not available").
export VLLM_WSL2_ENABLE_PIN_MEMORY=1
